@{
    ViewData["Title"] = "Mensaje";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4>Acceso por Género</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        @ViewBag.Message
                    </div>
                    <p>Tu género actual es: <strong>@User.FindFirst("genero")?.Value</strong></p>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Volver al Inicio</a>
                </div>
            </div>
        </div>
    </div>
</div>